# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Optional 32+ char secret for signing patient OTP report sessions.
# If unset, the server generates an in-memory random 256-bit key per process.
SESSION_SECRET=

# ADMIN_EMAILS: Optional comma-separated list of additional laboratory administrator emails.
ADMIN_EMAILS=
